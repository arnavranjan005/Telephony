{
  "name": "@telephony/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "eval:ai": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.eval.config.js",
    "eval:ai:case": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.eval.config.js -t"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.5.0",
    "@google/genai": "^2.10.0",
    "@telephony/config": "*",
    "@telephony/database": "*",
    "@telephony/domain": "*",
    "@telephony/queue": "*",
    "@telephony/shared-types": "*",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
