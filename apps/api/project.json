{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "apps/api" },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run typecheck", "cwd": "apps/api" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run test", "cwd": "apps/api" }
    },
    "eval:ai": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run eval:ai", "cwd": "apps/api" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "apps/api" }
    }
  }
}
