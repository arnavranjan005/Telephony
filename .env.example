# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/telephony?sslmode=require"

# Redis (BullMQ job queue - Aiven free tier Redis, TLS required)
REDIS_URL="rediss://default:PASSWORD@your-redis-project.aivencloud.com:12345"
# Set to false only if Aiven's CA isn't trusted by your runtime and you can't
# otherwise fix cert verification. Keep true in production.
REDIS_TLS_REJECT_UNAUTHORIZED=true
# Outbound dial throughput cap enforced by the worker (jobs per duration window)
DIAL_RATE_LIMIT_MAX=5
DIAL_RATE_LIMIT_DURATION_MS=1000

# Telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_WEBHOOK_SIGNING_SECRET=

# Google (OAuth for Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
GOOGLE_CALENDAR_ID=primary
# Long-lived refresh token obtained once via the OAuth consent flow
GOOGLE_REFRESH_TOKEN=

# AI provider
AI_PROVIDER=google
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash

# Bidirectional media streaming (real-time barge-in) - the default calling
# path. DEEPGRAM_API_KEY/ELEVENLABS_API_KEY/ELEVENLABS_VOICE_ID are required
# while this is on. Set MEDIA_STREAM_ENABLED=false to fall back to the
# legacy transcribe-then-speak webhook flow instead (no barge-in).
MEDIA_STREAM_ENABLED=true
MEDIA_STREAM_WS_PATH=/media-stream
MEDIA_STREAM_SAMPLE_RATE=8000
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2-phonecall
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Voice tuning (ElevenLabs voice_settings) - defaults favor a warmer, more
# natural-sounding phone voice over ElevenLabs' flatter stock defaults.
# stability/similarity_boost/style: 0-1. speed: 0.7-1.2.
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.3
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1.0
