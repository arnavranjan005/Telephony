generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  COLD
  WARM
  HOT
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELED
  COMPLETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

enum CampaignContactStatus {
  PENDING
  CALLING
  CALLED
  FAILED
  SKIPPED_DNC
}

enum FollowUpStatus {
  PENDING
  CALLING
  COMPLETED
  FAILED
  CANCELED
  SKIPPED_DNC
}

enum DncSource {
  MANUAL
  CALLER_REQUEST
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String?
  lastName    String?
  phoneNumber String   @unique
  email       String?
  status      LeadStatus @default(COLD)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calls            Call[]
  appointments     Appointment[]
  campaignContacts CampaignContact[]
  followUps        FollowUp[]

  @@index([status])
}

model Call {
  id                String        @id @default(cuid())
  telnyxCallControlId String?     @unique
  direction         CallDirection
  status            CallStatus    @default(QUEUED)
  fromNumber        String
  toNumber          String
  startedAt         DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  outcome           String?
  recordingUrl      String?

  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id])

  messages        ConversationMessage[]
  appointments    Appointment[]
  campaignContact CampaignContact?
  followUps       FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([status])
}

model Appointment {
  id                String            @id @default(cuid())
  title             String
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus @default(SCHEDULED)
  googleEventId     String?
  notes             String?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  callId String?
  call   Call?   @relation(fields: [callId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([startTime])
}

model ConversationMessage {
  id        String      @id @default(cuid())
  callId    String
  call      Call        @relation(fields: [callId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  toolName  String?
  toolArgs  Json?
  createdAt DateTime    @default(now())

  @@index([callId])
}

model Campaign {
  id         String         @id @default(cuid())
  name       String
  script     String?
  status     CampaignStatus @default(DRAFT)
  fromNumber String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  contacts CampaignContact[]

  @@index([status])
}

model CampaignContact {
  id          String                 @id @default(cuid())
  campaignId  String
  campaign    Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead                   @relation(fields: [leadId], references: [id])
  status      CampaignContactStatus  @default(PENDING)
  callId      String?                @unique
  call        Call?                  @relation(fields: [callId], references: [id])
  attemptedAt DateTime?
  createdAt   DateTime               @default(now())

  @@index([campaignId, status])
}

model FollowUp {
  id          String         @id @default(cuid())
  leadId      String
  lead        Lead           @relation(fields: [leadId], references: [id])
  callId      String?
  originCall  Call?          @relation(fields: [callId], references: [id])
  reason      String?
  scheduledAt DateTime
  status      FollowUpStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  @@index([status, scheduledAt])
}

model DncEntry {
  id          String    @id @default(cuid())
  phoneNumber String    @unique
  reason      String?
  source      DncSource @default(MANUAL)
  createdAt   DateTime  @default(now())
}

enum IdempotencyKeyStatus {
  PENDING
  COMPLETED
}

model IdempotencyKey {
  id             String               @id @default(cuid())
  key            String               @unique
  method         String
  path           String
  requestHash    String
  status         IdempotencyKeyStatus @default(PENDING)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime             @default(now())
  completedAt    DateTime?
}
