{
  "name": "telephony",
  "version": "0.1.0",
  "private": true,
  "description": "AI voice calling platform monorepo: Express API, BullMQ worker, Next.js admin panel",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build --all",
    "typecheck": "nx run-many -t typecheck --all",
    "test": "nx run-many -t test --all",
    "dev:api": "nx run api:dev",
    "dev:worker": "nx run worker:dev",
    "dev:web": "nx run web:dev",
    "e2e:up": "docker compose up -d --wait",
    "e2e:down": "docker compose down",
    "e2e:migrate": "DATABASE_URL=postgresql://telephony:telephony@localhost:55432/telephony_e2e npx prisma db push --schema packages/database/prisma/schema.prisma --skip-generate",
    "e2e": "npm run e2e:up && npm run e2e:migrate && nx run e2e:e2e"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "nx": "^20.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
